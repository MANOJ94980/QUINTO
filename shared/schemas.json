{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QGridShieldFrame",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "seq": { "type": "integer" },
    "ts": { "type": "number" },
    "session": { "type": "string" },
    "scenario": { "type": "string", "enum": ["grid", "rail", "av"] },
    "lane": { "type": "string", "enum": ["classical", "qgs"] },
    "channel": { "type": "string", "enum": ["quantum", "public", "data"] },
    "src": { "type": "string" },
    "dst": { "type": "string" },
    "type": { "type": "string" },
    "payload": { "type": "object" },
    "tag": { "type": "string" }
  },
  "required": ["id", "seq", "ts", "session", "scenario", "lane", "channel", "src", "dst", "type", "payload", "tag"]
}
